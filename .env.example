# LOCAL DEVELOPMENT: npm run setup:local creates .env.local with a random secret.
DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_FILE=.data/fieldora.sqlite
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long

# VERCEL: set these in Project Settings > Environment Variables.
# DATABASE_PROVIDER=turso
# TURSO_DATABASE_URL=libsql://your-database-your-organisation.turso.io
# TURSO_AUTH_TOKEN=your-database-auth-token
# SESSION_SECRET=your-own-random-secret-at-least-32-characters-long
# Never prefix secrets with NEXT_PUBLIC_.
